# Copy to .env.local and fill in. Never commit .env files.
#
# Every VITE_ variable is built into the public website and can be read by anyone.
# Only public values belong here. Never give a secret (service role key, Meta app
# secret, tokens) a VITE_ prefix. Server secrets live in Supabase Edge Function
# secrets and GitHub Actions secrets, see docs/ARCHITECTURE.md section 3.

# Supabase project URL, for example https://<project>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (publishable) key. Safe to publish only because of RLS.
VITE_SUPABASE_ANON_KEY=

# Sentry DSN for browser error reports. Leave empty to turn error reporting off.
VITE_SENTRY_DSN=

# Which environment this build is for: local, staging or production.
# Sample products show a "Sample" label everywhere except production.
VITE_APP_ENV=local
